# ===========================================
#  Шаблон переменных окружения для "За край"
#  Скопируйте в .env и заполните своими значениями:
#     cp .env.example .env
#  Файл .env в git НЕ коммитится (см. .gitignore).
# ===========================================

# Порт, на котором слушает Node. За Nginx обычно 3000.
PORT=3000

# Надёжный ключ для доступа к приватной статистике (GET /api/stats).
# ОБЯЗАТЕЛЕН, минимум 16 символов. Сгенерировать можно так:
#     node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
STATS_KEY=ЗАМЕНИТЕ_НА_СЛУЧАЙНЫЙ_КЛЮЧ_МИНИМУМ_16_СИМВОЛОВ

# Разрешённые источники для CORS, через запятую.
# Для продакшена укажите свой домен. Если пусто — CORS открыт (только для разработки).
# Пример:
#     ALLOWED_ORIGINS=https://zakray.ru,https://www.zakray.ru
ALLOWED_ORIGINS=

# Какой файл сериала использовать (по умолчанию series_v2.json).
SERIES_FILE=series_v2.json
