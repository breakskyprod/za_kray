# ===========================================
#  systemd-юнит для автозапуска Node-сервера "За край"
#  Разместить: /etc/systemd/system/zakray.service
#  Затем:
#     sudo systemctl daemon-reload
#     sudo systemctl enable zakray      # автозапуск при загрузке VPS
#     sudo systemctl start zakray
#     sudo systemctl status zakray      # проверить
#     sudo journalctl -u zakray -f      # смотреть логи
#
#  Замените User и пути под свой сервер.
# ===========================================

[Unit]
Description=Za Kray interactive series server
After=network.target

[Service]
Type=simple
# Пользователь, от которого работает сервис (не root!)
User=www-data
# Рабочая папка = папка server, где лежит app.js и .env
WorkingDirectory=/var/www/za_kray/server
# Путь к node уточните командой: which node
ExecStart=/usr/bin/node app.js
# Автоматический перезапуск при падении
Restart=always
RestartSec=5
# Переменные окружения берутся из .env (dotenv), но можно задать и тут:
Environment=NODE_ENV=production
# Логи идут в journald (смотреть через journalctl)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
